# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/tradesolt_db?schema=public"

# JWT
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRES_IN=7d

# OpenRouter AI
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# WhatsApp (Meta WhatsApp Cloud API)
# 1. Create a WhatsApp Business app in Meta for Developers (https://developers.facebook.com)
# 2. Get these values from the app's WhatsApp > API Setup / App dashboard.
WHATSAPP_VERIFY_TOKEN=test
WHATSAPP_ACCESS_TOKEN=test
WHATSAPP_PHONE_NUMBER_ID=test
WhatsApp Business Account ID=test
# Callback URL to register in Meta: https://your-domain.com/api/webhooks/whatsapp
# Verify token must match WHATSAPP_VERIFY_TOKEN; subscription = messages

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
STRIPE_ACCOUNT_COUNTRY=BD
STRIPE_CURRENCY=usd
CLIENT_URL=http://localhost:3000
